{
  "name": "asana-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:smoke": "RUN_COMPILED_SMOKE=1 bun test test/smoke.test.ts",
    "smoke:executable": "bun run scripts/smoke-executable.ts",
    "build": "bun run scripts/build.ts",
    "build:target": "bun run scripts/build.ts --target",
    "build:release": "bun run scripts/build.ts --all",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run test:smoke"
  },
  "dependencies": {
    "commander": "14.0.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/bun": "1.3.14",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  }
}

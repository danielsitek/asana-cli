{
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".github/instructions/git.instructions.md"
    }
  ],
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.skillTool.enabled": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  },
  "chat.useAgentsMdFile": true,
  "chat.hookFilesLocations": {
    ".github/hooks": true
  },
  "prettier.useEditorConfig": true,
  "prettier.singleQuote": false,
  "chat.tools.terminal.autoApprove": {
    "/^git (config|branch|status|fetch|log|diff|show|ls-files|rev-parse|remote|tag|shortlog)(\\b.*)?$/": true,
    "/^git stash (list|show)(\\b.*)?$/": true,
    "npx tsc": true,
    "npm run": true,
    "glab": true
  }
}
